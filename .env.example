# Netlify: ativar Forms no painel e manter o modo netlify.
# Vercel: escolher formspree e indicar o endpoint público do formulário.
VITE_FORM_PROVIDER=netlify
VITE_FORMSPREE_ENDPOINT=

# Chave pública (anon/publishable) do projeto; nunca usar service_role no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Só ativar depois de aplicar a migração e confirmar a política de logs/privacidade do Supabase.
VITE_TELEMETRY_ENABLED=false
